# FRIDAY - AI Desktop Assistant
# Environment Variables Template
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env (or copy .env.example .env on Windows)
# 2. Edit .env and replace the placeholder values with your actual API keys
# 3. Never commit .env to GitHub (it's protected by .gitignore)

# OpenAI API Key - Required for agent mode
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model used by the Responses API tool-calling loop
OPENAI_MODEL=gpt-5.4-mini

# Optional: extra allowed roots for file access, separated by your OS path separator
# Windows example:
# FRIDAY_ALLOWED_ROOTS=C:\Work;D:\Notes
FRIDAY_ALLOWED_ROOTS=

# Optional: start with voice output enabled
FRIDAY_VOICE_OUTPUT=false

